      "name": "Acción",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a006",
              "name": "ts",
              "value": "={{ Math.floor(Date.now() / 1000).toString() }}",
              "type": "string"
            },
            {
              "id": "a007",
              "name": "body",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a008",
      "name": "Firmar catálogo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        100
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.ts + '.' + $json.body }}",
        "dataPropertyName": "signature",
        "secret": "={{ $vars.BOT_WEBHOOK_SECRET }}",
        "encoding": "hex"
      },
      "id": "a009",
      "name": "HMAC catálogo",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        680,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.WEB_BASE_URL }}/api/bot/catalogo",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Hub-Signature-256",
              "value": "={{ 'sha256=' + $json.signature }}"
            },
            {
              "name": "X-Bot-Timestamp",
              "value": "={{ $json.ts }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a010",
      "name": "GET catálogo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a011",
              "name": "ts",
              "value": "={{ Math.floor(Date.now() / 1000).toString() }}",
              "type": "string"
            },
            {
              "id": "a012",
              "name": "body",
              "value": "={{ JSON.stringify({ externalId: $json.externalId, source: $json.channel === 'whatsapp' ? 'WHATSAPP' : 'WEB', customerName: $json.customerName, customerPhone: $json.customerPhone, items: JSON.parse($json.items || '[]'), notes: $json.notes || undefined }) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a013",
      "name": "Firmar pedido",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300

    {
      "parameters": {
        "operation": "sendTemplate",
        "phoneNumberId": "={{ $vars.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $vars.OWNER_WHATSAPP }}",
        "template": "pedido_nuevo|es_MX",
        "components": {
          "component": [
            {
              "type": "body",
              "bodyParameters": {
                "parameter": [
                  {
                    "type": "text",
                    "text": "={{ $json.data.folio }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $('Entrada').item.json.customerName }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $('Entrada').item.json.customerPhone }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.data.total }}"
                  },
                  {
                    "type": "text",
                    "text": "={{ $json.data.pickupDate }}"
                  }
                ]
              }
            }
          ]
        }
      },

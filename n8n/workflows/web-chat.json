{
  "name": "Pollos — chat web",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pollos-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "w001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "pollos-chat"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "w002",
              "name": "ts",
              "value": "={{ $json.headers['x-bot-timestamp'] }}",
              "type": "string"
            },
            {
              "id": "w003",
              "name": "toSign",
              "value": "={{ $json.headers['x-bot-timestamp'] + '.' + JSON.stringify($json.body) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "w004",
      "name": "Preparar firma",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.toSign }}",
        "dataPropertyName": "signature",
        "secret": "={{ $vars.BOT_WEBHOOK_SECRET }}",
        "encoding": "hex"
      },
      "id": "w005",
      "name": "HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "w006",
              "leftValue": "={{ $('Webhook').item.json.headers['x-hub-signature-256'] === 'sha256=' + $json.signature && Math.abs(Math.floor(Date.now() / 1000) - Number($json.ts)) <= 300 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w007",
      "name": "¿Firma válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Pollos — agente"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "sessionId": "={{ $('Webhook').item.json.body.sessionId }}",
            "messageId": "={{ $('Webhook').item.json.body.messageId }}",
            "message": "={{ $('Webhook').item.json.body.message }}",
            "channel": "web",
            "customerPhone": ""
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "sessionId",
              "displayName": "sessionId",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "messageId",
              "displayName": "messageId",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "message",
              "displayName": "message",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "channel",
              "displayName": "channel",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            },
            {
              "id": "customerPhone",
              "displayName": "customerPhone",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true,
              "type": "string"
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "w008",
      "name": "Agente",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: $json.reply }) }}",
        "options": {}
      },
      "id": "w009",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\":\"No autorizado\"}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "w010",
      "name": "Rechazar",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        420
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Preparar firma",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar firma": {
      "main": [
        [
          {
            "node": "HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HMAC": {
      "main": [
        [
          {
            "node": "¿Firma válida?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Firma válida?": {
      "main": [
        [
          {
            "node": "Agente",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Rechazar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Agente": {
      "main": [
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

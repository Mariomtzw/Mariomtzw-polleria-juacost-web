# ─── Supabase / PostgreSQL ───
# Connection pooling (pgbouncer) — la usa la app en runtime
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa — la usan las migraciones de Prisma
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Auth.js (NextAuth v5) ───
# Genera el secreto con:  openssl rand -base64 32
AUTH_SECRET="pega-aqui-tu-secreto"
AUTH_TRUST_HOST=true

# ─── Seed del dueño (solo para poblar la BD la primera vez) ───
OWNER_EMAIL="dueno@pollosjuacost.com"
# Obligatoria para el seed (mínimo 12 caracteres). Genera una con:  openssl rand -base64 18
OWNER_PASSWORD=""

# ─── Recuperación de contraseña por correo (Resend: https://resend.com) ───
# Clave de la cuenta de Resend. Sin ella, "¿Olvidaste tu contraseña?" avisa que
# no está configurado y en desarrollo el correo se escribe en la terminal.
RESEND_API_KEY=""
# Remitente. Sin un dominio propio verificado en Resend, deja el de pruebas:
# solo entrega al correo con el que se creó la cuenta de Resend (debe ser el
# mismo correo con el que el dueño entra al panel).
MAIL_FROM="Pollos Juacos't <onboarding@resend.dev>"
# Dirección pública del sitio para armar el enlace del correo. En Vercel no hace
# falta (se usa el dominio de producción del proyecto); defínela solo si tienes
# dominio propio.
# APP_URL="https://tu-dominio.com"

# ─── Vercel Blob (se usará en fases posteriores) ───
# BLOB_READ_WRITE_TOKEN=""

# ─── Supabase / PostgreSQL ───
# Connection pooling (pgbouncer) — la usa la app en runtime
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa — la usan las migraciones de Prisma
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Auth.js (NextAuth v5) ───
# Genera el secreto con:  openssl rand -base64 32
AUTH_SECRET="pega-aqui-tu-secreto"
AUTH_TRUST_HOST=true

# ─── Seed del dueño (solo para poblar la BD la primera vez) ───
OWNER_EMAIL="dueno@pollosjuacost.com"
# Obligatoria para el seed (mínimo 12 caracteres). Genera una con:  openssl rand -base64 18
OWNER_PASSWORD=""

# ─── Vercel Blob (se usará en fases posteriores) ───
# BLOB_READ_WRITE_TOKEN=""
